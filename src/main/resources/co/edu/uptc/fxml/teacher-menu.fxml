<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<StackPane xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="co.edu.uptc.viewController.TeacherDashboardController"
           stylesheets="@../styles/styles.css"
           prefWidth="900" prefHeight="640">
        <StackPane 
           styleClass="fondo-cuaderno" >
    <children>
        <VBox spacing="18" styleClass="student-dashboard">
            <padding>
                <Insets top="22" right="30" bottom="22" left="30"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="20">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="%teacher.menu.brand" styleClass="auth-brand"/>
                    <Label fx:id="lblWelcome" styleClass="auth-title"/>
                    <Label text="%teacher.menu.subtitle" styleClass="auth-subtitle"/>
                </VBox>
                <VBox alignment="CENTER_RIGHT" spacing="8">
                    <ComboBox fx:id="languageSelector" onAction="#onLanguageChanged"
                              accessibleText="%common.language" styleClass="language-selector"/>
                    <Label fx:id="lblCourseCount" styleClass="course-count"/>
                </VBox>
            </HBox>

           

            <StackPane VBox.vgrow="ALWAYS">
                <VBox fx:id="coursesView" spacing="14" styleClass="courses-panel">
                    <Label text="%teacher.menu.courses.title" styleClass="section-title"/>
                    <Label fx:id="lblEmptyCourses" text="%teacher.menu.courses.empty"
                           visible="false" managed="false" wrapText="true"
                           styleClass="auth-subtitle"/>
                    <VBox fx:id="courseListHost" VBox.vgrow="ALWAYS"/>
                </VBox>

                <VBox fx:id="courseDetailView" visible="false" managed="false" spacing="12">
                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <Button text="%catalog.back" onAction="#onBackToCourses"
                                styleClass="boton-dibujado"/>
                        <Label fx:id="lblSelectedCourseTitle" styleClass="section-title"
                               HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <Label fx:id="lblSelectedCourseId" styleClass="course-count"/>
                    <Label fx:id="lblSelectedCourseDescription" wrapText="true"
                           styleClass="auth-subtitle"/>
                    <Label text="%catalog.tree.title" styleClass="section-title"/>
                    <Label text="%catalog.tree.navigationHint" wrapText="true"
                           styleClass="auth-hint"/>
                    <HBox spacing="16" VBox.vgrow="ALWAYS">
                        <StackPane fx:id="courseTreeHost" HBox.hgrow="ALWAYS"
                                   styleClass="course-tree-panel"/>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefWidth="350" minWidth="320" styleClass="node-details-scroll-pane">
                            <content>
                                <VBox spacing="10" styleClass="node-details-panel">
                                    <Label text="%catalog.node.details" styleClass="section-title"/>
                                    <Label fx:id="lblNodeTitle" text="%catalog.node.select" wrapText="true" styleClass="node-title"/>
                                    <Label fx:id="lblNodeType" wrapText="true" styleClass="course-count"/>
                                    <Label fx:id="lblNodeDescription" wrapText="true" styleClass="node-description"/>
                                    <Button fx:id="btnDeleteNode" text="%teacher.node.delete"
                                            visible="false" managed="false" onAction="#onDeleteSelectedNode"
                                            styleClass="boton-dibujado"/>
                                    <Button fx:id="btnCreateModule" text="%teacher.node.createModule" visible="false" managed="false" onAction="#onCreateModule" styleClass="boton-dibujado"/>
                                    <Button fx:id="btnCreateLesson" text="%teacher.node.createLesson" visible="false" managed="false" onAction="#onCreateLesson" styleClass="boton-dibujado"/>
                                    <VBox fx:id="createModuleForm" visible="false" managed="false" spacing="8">
                                        <Label text="%teacher.node.moduleForm.title" styleClass="section-title"/>
                                        <TextField fx:id="txtModuleTitle" promptText="%teacher.node.title.prompt" styleClass="auth-input"/>
                                        <TextArea fx:id="txtModuleDescription" promptText="%teacher.node.description.prompt" wrapText="true" prefRowCount="3" styleClass="auth-input"/>
                                        <HBox alignment="CENTER_RIGHT" spacing="8">
                                            <Button text="%teacher.node.cancel" onAction="#onCancelNodeCreation" styleClass="boton-dibujado"/>
                                            <Button text="%teacher.node.saveModule" onAction="#onSaveModule" styleClass="boton-dibujado"/>
                                        </HBox>
                                    </VBox>
                                    <VBox fx:id="createLessonForm" visible="false" managed="false" spacing="8">
                                        <Label text="%teacher.node.lessonForm.title" styleClass="section-title"/>
                                        <TextField fx:id="txtLessonTitle" promptText="%teacher.node.title.prompt" styleClass="auth-input"/>
                                        <TextArea fx:id="txtLessonDescription" promptText="%teacher.node.description.prompt" wrapText="true" prefRowCount="3" styleClass="auth-input"/>
                                        <TextField fx:id="txtLessonDuration" promptText="%teacher.node.duration.prompt" styleClass="auth-input"/>
                                        <HBox alignment="CENTER_RIGHT" spacing="8">
                                            <Button text="%teacher.node.cancel" onAction="#onCancelNodeCreation" styleClass="boton-dibujado"/>
                                            <Button text="%teacher.node.saveLesson" onAction="#onSaveLesson" styleClass="boton-dibujado"/>
                                        </HBox>
                                    </VBox>
                                    <Label fx:id="lblNodeActionMessage" visible="false" managed="false" wrapText="true" styleClass="auth-message"/>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </HBox>
                </VBox>

                <VBox fx:id="createCourseView" visible="false" managed="false"
                      alignment="CENTER" spacing="14" styleClass="auth-card"
                      maxWidth="600">
                    <padding>
                        <Insets top="28" right="36" bottom="28" left="36"/>
                    </padding>
                    <Label text="%teacher.course.create.title" styleClass="section-title"/>
                    <Label text="%teacher.course.create.subtitle" wrapText="true"
                           styleClass="auth-subtitle"/>
                    <TextField fx:id="txtCourseTitle" promptText="%teacher.course.create.title.prompt"
                               styleClass="auth-input"/>
                    <TextArea fx:id="txtCourseDescription"
                              promptText="%teacher.course.create.description.prompt"
                              wrapText="true" prefRowCount="5" styleClass="auth-input"/>
                    <Label fx:id="lblMessage" visible="false" managed="false"
                           wrapText="true" styleClass="auth-message"/>
                    <HBox alignment="CENTER_RIGHT" spacing="12">
                        <Button text="%teacher.course.create.cancel" onAction="#onShowCourses"
                                styleClass="boton-dibujado"/>
                        <Button text="%teacher.course.create.action" onAction="#onSaveNewCourse"
                                styleClass="boton-dibujado"/>
                    </HBox>
                </VBox>
            </StackPane>
        </VBox>
    </children>
</StackPane>
    <children>
        <!-- MENÚ INFERIOR CON OPCIONES PRINCIPALES -->
            <VBox fx:id="contenedorMenuAnimado" 
                    alignment="BOTTOM_LEFT"
                    StackPane.alignment="BOTTOM_LEFT"
                    pickOnBounds="false">
                <Button fx:id="btnToggleMenu" styleClass="boton-menu" onAction="#toggleMenu">
                <VBox.margin>
                <Insets left="20.0" />
                </VBox.margin></Button>
                <HBox fx:id="menuHoja" 
                    styleClass="hoja-desplegable" 
                        maxWidth="400" 
                        maxHeight="250" 
                        alignment="TOP_CENTER" 
                        StackPane.alignment="BOTTOM_CENTER">
        
                 <HBox alignment="CENTER_LEFT" spacing="12">
                    <Button fx:id="btnMyCourses" text="%teacher.menu.courses.title"
                        onAction="#onShowCourses" styleClass="boton-dibujado"/>
                        <Button fx:id="btnCreateNewCourse" text="%teacher.menu.createCourse"
                         onAction="#onCreateNewCourse" styleClass="boton-dibujado"/>
                        <Button text="%menu.logout" onAction="#onLogout" styleClass="boton-dibujado"/>
                        <Button text="%menu.exit" onAction="#onExit" styleClass="boton-dibujado"/>
                </HBox>
                </HBox>
            </VBox>
    </children>
        
</StackPane>
