<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="co.edu.uptc.viewController.TeacherDashboardController"
           styleClass="fondo-cuaderno" stylesheets="@../styles/styles.css"
           prefWidth="900" prefHeight="640">
    <children>
        <VBox alignment="CENTER" spacing="20" maxWidth="560" styleClass="menu-card">
            <padding>
                <Insets top="34" right="42" bottom="34" left="42"/>
            </padding>
            <HBox alignment="CENTER_RIGHT" maxWidth="Infinity">
                <children>
                    <ComboBox fx:id="languageSelector" onAction="#onLanguageChanged"
                              accessibleText="%common.language" styleClass="language-selector"/>
                </children>
            </HBox>
            <Label text="%teacher.menu.brand" styleClass="auth-brand"/>
            <Label fx:id="lblWelcome" styleClass="auth-title"/>
            <Label text="%teacher.menu.subtitle" wrapText="true" styleClass="auth-subtitle"/>
            <VBox alignment="CENTER" spacing="12" styleClass="courses-panel">
                <children>
                    <Label text="%teacher.menu.courses.title" styleClass="section-title"/>
                    <Label fx:id="lblCourseCount" styleClass="course-count"/>
                    <Label fx:id="lblCourseList" wrapText="true" styleClass="auth-subtitle"/>
                </children>
            </VBox>
            <Button text="%menu.logout" maxWidth="Infinity" onAction="#onLogout"
                    styleClass="boton-dibujado"/>
            <Button text="%menu.exit" maxWidth="Infinity" onAction="#onExit"
                    styleClass="boton-dibujado"/>
        </VBox>
    </children>
</StackPane>
