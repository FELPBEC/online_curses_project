<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<StackPane xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="co.edu.uptc.viewController.RoleSelectionController"
           styleClass="fondo-portada" stylesheets="@../styles/styles.css"
           prefWidth="900" prefHeight="640">
    <children>
        <VBox alignment="CENTER" spacing="20" maxWidth="590" styleClass="menu-card">
            <padding>
                <Insets top="34" right="44" bottom="38" left="44"/>
            </padding>
            <ImageView fitWidth="150" fitHeight="150" preserveRatio="true">
                <image>
                    <Image url="@../images/Logo.png" />
                </image>
            </ImageView>
            <HBox alignment="CENTER_RIGHT" maxWidth="Infinity">
                <children>
                    <ComboBox fx:id="languageSelector" onAction="#onLanguageChanged"
                              accessibleText="%common.language" styleClass="language-selector"/>
                </children>
            </HBox>
            <Label text="%home.brand" styleClass="auth-brand"/>
            <Label text="%home.title" styleClass="auth-title"/>
            <Label text="%home.subtitle" wrapText="true" styleClass="auth-subtitle"/>
            <VBox spacing="14" maxWidth="380">
                <children>
                    <Button text="%home.student" onAction="#onStudentSelected"
                            maxWidth="Infinity" styleClass="boton-dibujado"/>
                    <Button text="%home.teacher" onAction="#onTeacherSelected"
                            maxWidth="Infinity" styleClass="boton-dibujado"/>
                    <Button text="%menu.exit" onAction="#onExit"
                            maxWidth="Infinity" styleClass="boton-dibujado"/>
                </children>
            </VBox>
            <Label text="%home.footer" wrapText="true" styleClass="auth-hint"/>
        </VBox>
    </children>
</StackPane>
